PORT=3000
REPO_PATH=./demo-repo
AGENT_COMMAND=cursor agent --print

# Database — omit DATABASE_URL for SQLite (default).
# SQLITE_PATH=./data.db
# For Postgres instead: DATABASE_URL=postgres://user:pass@host:5432/db

# Server API key — only needed for Cloud / authMode=server|byok.
# Local runtime defaults to Cursor CLI login (no key).
CURSOR_API_KEY=

# Optional fallback Anthropic key for Claude Code cloud when the user has no BYOK.
# Prefer per-user Anthropic BYOK from the Create / Add Agent UI.
# ANTHROPIC_API_KEY=

# E2B — required for Claude Code cloud sandboxes (https://e2b.dev)
# E2B_API_KEY=

# GitHub token for Claude Code cloud: clone private repos, push working branches, open PRs.
# PAT or GitHub App installation token with contents:write + pull_requests:write.
# GITHUB_TOKEN=
# GH_TOKEN=

# Comma-separated Clerk user IDs allowed to pick up / clear the shared server key in the UI.
# If empty, only CURSOR_API_KEY (env) can supply the server key.
# ADMIN_USER_IDS=user_xxx,user_yyy

# AES key material for encrypting BYOK + picked-up server keys + Anthropic BYOK (64-char hex or passphrase)
KEY_ENCRYPTION_SECRET=

# Auth secret (legacy deploy var; CLI tokens are random hex + SHA-256)
AUTH_SECRET=dev-secret-change-in-production

# Optional Redis for multi-instance Socket.IO
# REDIS_URL=redis://localhost:6379

# Invite link lifetime (ms). Default: 7 days.
# INVITE_TTL_MS=604800000

# Clerk (https://dashboard.clerk.com) — required for web sign-in
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Public URL for Socket.IO (set to your domain in production)
# NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# Default model id when create form omits one
DEFAULT_MODEL=composer-2.5

# Comma-separated browser origins allowed in production
# CORS_ORIGIN=https://your-app.vercel.app
