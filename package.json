{
  "name": "shared-agent-session",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "cd web && ./node_modules/.bin/next dev --port 3001",
    "build": "tsc --noEmit && cd web && ./node_modules/.bin/next build",
    "build:server": "tsc --outDir dist",
    "start": "node dist/server/index.js",
    "start:server": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "chmod +x node_modules/.pnpm/node-pty@*/node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "smoke:pty": "tsx scripts/smoke-pty.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.1",
    "@cursor/sdk": "^1.0.24",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "nanoid": "^6.0.0",
    "node-pty": "^1.0.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "simple-git": "^3.27.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
