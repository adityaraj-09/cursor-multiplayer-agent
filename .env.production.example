# ── Split deploy: Vercel (web) + Render (API + SQLite) ──────────────
NODE_ENV=production

# ── Render (API / Socket.IO / SQLite) ───────────────────────────────
PORT=3000

# Leave DATABASE_URL unset to use SQLite.
# On Render, put the DB on a persistent disk:
SQLITE_PATH=/var/data/steer.db

# Comma-separated Vercel origins allowed to call the API
CORS_ORIGIN=https://your-app.vercel.app

AUTH_SECRET=              # openssl rand -hex 32
KEY_ENCRYPTION_SECRET=    # openssl rand -hex 32
CLERK_SECRET_KEY=sk_live_...
CURSOR_API_KEY=           # optional — Cursor Cloud / server auth
ANTHROPIC_API_KEY=        # optional fallback — prefer user Anthropic BYOK
OPENAI_API_KEY=           # optional fallback — prefer user OpenAI BYOK for Codex
BL_API_KEY=               # required for Claude Code / Codex cloud (Blaxel)
BL_WORKSPACE=             # required Blaxel workspace slug
# BLAXEL_REGION=us-pdx-1
# BLAXEL_SANDBOX_MEMORY=4096
# BLAXEL_SANDBOX_TTL=1h
GITHUB_TOKEN=             # push/PR for Claude Code / Codex cloud (or GH_TOKEN)
DEFAULT_MODEL=auto

# ── Vercel (Next.js web) ────────────────────────────────────────────
# API_URL=https://steer-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://steer-api.onrender.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
