# Production environment
NODE_ENV=production

# Database — use postgres:// for production, omit for SQLite
DATABASE_URL=postgres://shared_agent:shared_agent@db:5432/shared_agent

# Server
PORT=3000

# Public URL — set to your domain for production
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# Auth secret for JWT tokens
AUTH_SECRET=change-me-to-a-random-64-char-string

# Encryption key for API keys stored in DB (64-char hex)
KEY_ENCRYPTION_SECRET=change-me-to-a-random-64-char-hex

# Optional: shared server Cursor API key (for Cloud runtime)
CURSOR_API_KEY=

# Default model
DEFAULT_MODEL=auto
